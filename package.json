{
  "name": "studyapp",
  "version": "0.1.0",
  "private": true,
  "description": "Personal study app with a plant game",
  "main": "out/main/index.js",
  "author": "Tobias Weiß",
  "build": {
    "appId": "local.studyapp",
    "productName": "StudyApp",
    "files": [
      "out/**"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dir",
      "identity": "-"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "app": "electron-vite build && electron-builder --dir",
    "shots": "electron-vite build && electron scripts/screenshots.cjs",
    "flow": "electron-vite build && electron scripts/study-flow.cjs",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "ts-fsrs": "^6.0.0"
  }
}
